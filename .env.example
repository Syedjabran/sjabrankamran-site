# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Exam Lab answer security (optional): the secret behind signed sitting tokens,
# Maxwell mark receipts and sealed practice sets (src/lib/exam-lab/keys.ts).
# Unset: keys are derived from SUPABASE_SERVICE_ROLE_KEY instead. Rotating
# either ends open sittings (their tokens stop verifying). 32+ random chars.
# Decide before the portal-v2 deploy and never set or change it mid-term:
# docs/DEPLOY-PORTAL-V2.md (step 3).
EXAM_LAB_SECRET=

# Resend (contact form email)
RESEND_API_KEY=your-resend-key
CONTACT_TO_EMAIL=hello@sjabrankamran.com
CONTACT_FROM_EMAIL=no-reply@sjabrankamran.com

# AI Physics Tutor (public website) — GOOGLE GEMINI ONLY (per policy)
# Without a key, questions defer to teacher review instead of an AI answer.
GEMINI_API_KEY=your-gemini-key
# Optional model override. Default is the fast, non-thinking flash-lite tier.
# Do NOT use the generic "gemini-flash-latest" alias — it now maps to a slow
# reasoning model that exceeds the serverless time budget.
GEMINI_MODEL=gemini-3.1-flash-lite

# Site
# Also the base of password-reset links (/api/portal/forgot-password); when
# unset, the request's own origin is used. Never taken from the client.
NEXT_PUBLIC_SITE_URL=https://www.sjabrankamran.com

# Vercel Cron auth (/api/cron/*). When set, Vercel sends
# "Authorization: Bearer <CRON_SECRET>" and cron routes require exactly that.
# When unset, they fall back to the spoofable x-vercel-cron / User-Agent check
# and log a warning. Use a long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=your-long-random-cron-secret

# Google Drive + Google Classroom (Physics Resources import) — physics@sjabrankamran.com
# One-time OAuth: create a Desktop OAuth client in Google Cloud, then mint a
# refresh token (see scripts/google-connect.mjs). All three are required to
# enable the "Import from Google" panel; without them the rest of Resources works.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Optional display label for the connected account
GOOGLE_ACCOUNT_EMAIL=physics@sjabrankamran.com

# Local development only: serve SAT question images from the local crop folder
# (scripts/exam-lab/ingest-sat/out/crops) instead of the storage bucket, before
# the live SAT upload has run. Ignored in production.
SAT_LOCAL_CROPS=

# SAT Coach AI (insights/tutor/parent summaries) — GOOGLE GEMINI or GROQ ONLY
# (per policy; see scripts/check-ai-provider-policy.mjs). Without either key,
# the coach falls back to deterministic text everywhere.
# "gemini" | "groq"; unset picks Gemini when GEMINI_API_KEY is set, else Groq
# when GROQ_API_KEY is set, else no provider.
SAT_AI_PROVIDER=
# Groq free tier (testing): 1,000 requests/day, 8,000 tokens/minute.
GROQ_API_KEY=your-groq-key
# Default supports JSON mode + images.
GROQ_MODEL=qwen/qwen3.8-27b
# Text-only; tried once after the primary model fails twice.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Best-effort global daily cap across all students, so the Groq free tier is
# never exhausted by a single busy day.
SAT_AI_DAILY_BUDGET=800

# Practical Lab (/api/lab): the secret every attempt's hidden apparatus values,
# reading noise and attempt tokens are derived from. Required everywhere except
# `next dev` -- without it (or shorter than 32 characters) the lab API refuses
# with "isn't set up on the server yet"; `next dev` uses a fixed secret. Use a long random
# string (e.g. `openssl rand -hex 32`). Changing it gives every student new
# apparatus values and ends the lab sessions of any room that is open.
# Required for the portal-v2 deploy: docs/DEPLOY-PORTAL-V2.md (step 3).
LAB_SECRET=your-long-random-lab-secret
