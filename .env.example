# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (contact form email)
RESEND_API_KEY=your-resend-key
CONTACT_TO_EMAIL=hello@sjabrankamran.com
CONTACT_FROM_EMAIL=no-reply@sjabrankamran.com

# AI Physics Tutor (public website) — GOOGLE GEMINI ONLY (per policy)
# Without a key, questions defer to teacher review instead of an AI answer.
GEMINI_API_KEY=your-gemini-key
# Optional model override. Default is the fast, non-thinking flash-lite tier.
# Do NOT use the generic "gemini-flash-latest" alias — it now maps to a slow
# reasoning model that exceeds the serverless time budget.
GEMINI_MODEL=gemini-3.1-flash-lite

# Site
# Also the base of password-reset links (/api/portal/forgot-password); when
# unset, the request's own origin is used. Never taken from the client.
NEXT_PUBLIC_SITE_URL=https://www.sjabrankamran.com

# Vercel Cron auth (/api/cron/*). When set, Vercel sends
# "Authorization: Bearer <CRON_SECRET>" and cron routes require exactly that.
# When unset, they fall back to the spoofable x-vercel-cron / User-Agent check
# and log a warning. Use a long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=your-long-random-cron-secret

# Google Drive + Google Classroom (Physics Resources import) — physics@sjabrankamran.com
# One-time OAuth: create a Desktop OAuth client in Google Cloud, then mint a
# refresh token (see scripts/google-connect.mjs). All three are required to
# enable the "Import from Google" panel; without them the rest of Resources works.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Optional display label for the connected account
GOOGLE_ACCOUNT_EMAIL=physics@sjabrankamran.com
