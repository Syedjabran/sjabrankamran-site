# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (contact form email)
RESEND_API_KEY=your-resend-key
CONTACT_TO_EMAIL=hello@sjabrankamran.com
CONTACT_FROM_EMAIL=no-reply@sjabrankamran.com

# AI Physics Tutor (public website) — GOOGLE GEMINI ONLY (per policy)
# Without a key, questions defer to teacher review instead of an AI answer.
GEMINI_API_KEY=your-gemini-key
# Optional model override. Default is the fast, non-thinking flash-lite tier.
# Do NOT use the generic "gemini-flash-latest" alias — it now maps to a slow
# reasoning model that exceeds the serverless time budget.
GEMINI_MODEL=gemini-3.1-flash-lite

# Site
NEXT_PUBLIC_SITE_URL=https://www.sjabrankamran.com
