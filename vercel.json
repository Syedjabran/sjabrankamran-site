      "destination": "https://sjabrankamran.com/:path*",
      "permanent": true
    },
    { "source": "/portal", "destination": "https://scholexai.com/portal", "permanent": true },
    { "source": "/portal/:path*", "destination": "https://scholexai.com/portal/:path*", "permanent": true },
    { "source": "/register/:path*", "destination": "https://scholexai.com/register/:path*", "permanent": true },
    { "source": "/lab", "destination": "https://scholexai.com/lab", "permanent": true },
    { "source": "/lab/:path*", "destination": "https://scholexai.com/lab/:path*", "permanent": true },
    { "source": "/api/portal/:path*", "destination": "https://scholexai.com/api/portal/:path*", "permanent": true },
    { "source": "/api/exam-lab/:path*", "destination": "https://scholexai.com/api/exam-lab/:path*", "permanent": true }
  ]
}
