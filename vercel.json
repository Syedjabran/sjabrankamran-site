{
  "firewall": {
    "rules": [
      {
        "action": "bypass",
        "name": "allow human browsers",
        "active": true,
        "conditionGroup": [
          {
            "conditions": [
              {
                "type": "header",
                "key": "user-agent",
                "op": "re",
                "value": "(?i)(chrome|firefox|safari|edge|crios|fxios|gsa)/"
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sjabrankamran.com" }],
      "destination": "https://sjabrankamran.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    { "path": "/api/cron/daily-study-plans", "schedule": "0 1 * * *" },
    { "path": "/api/cron/saturday-parent-reports", "schedule": "0 13 * * 6" }
  ]
}
